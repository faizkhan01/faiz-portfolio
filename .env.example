# Groq is the dynamic chat provider (free tier, no billing needed).
GROK_API_KEY=replace-with-your-groq-api-key
GROK_CHAT_MODEL=openai/gpt-oss-20b
GROK_WEB_SEARCH_MODEL=groq/compound-mini
GROK_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions
GROK_MAX_TOKENS=550

# Optional: real web search for current-world questions, tried before Groq's
# own web-search model — more reliable than Groq's compound/agentic models,
# which can hit payload-size limits or tool-call hallucinations on the free
# tier. Free: 1,000 searches/month, no card. Get a key at https://app.tavily.com.
# TAVILY_API_KEY=replace-with-your-tavily-api-key
# TAVILY_MAX_RESULTS=5

PORT=4173
