# Primary dynamic-chat provider. Leave unset (or use any value other than
# "gemini") to keep Groq/Grok as primary. Set AI_PROVIDER=gemini to route the
# primary provider to Google's Gemini API via its OpenAI-compatible endpoint;
# OpenRouter (below) remains the fallback in both cases.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_CHAT_COMPLETIONS_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#
# Current-world questions use Gemini's native generateContent endpoint with the
# built-in google_search grounding tool (real cited sources). Grounding is free
# only on Gemini 2.5 Flash/Flash-Lite (up to 500 req/day); NOT on the free tier
# for Gemini 3.x. Set GEMINI_GROUNDING=false to disable and answer model-only.
# GEMINI_WEB_SEARCH_MODEL=gemini-2.5-flash-lite
# GEMINI_GROUNDING=true
# GEMINI_GENERATE_CONTENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Groq is the default dynamic chat provider.
GROK_API_KEY=replace-with-your-groq-api-key
GROK_CHAT_MODEL=llama-3.1-8b-instant
GROK_WEB_SEARCH_MODEL=groq/compound-mini
GROK_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions
GROK_MAX_TOKENS=550

# Optional fallback provider when Groq is unavailable or rate-limited.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_CHAT_MODEL=openrouter/auto
OPENROUTER_WEB_SEARCH_MODEL=openrouter/auto
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MAX_TOKENS=500
OPENROUTER_SITE_URL=https://faizurrahman-portfolio.web.app
OPENROUTER_APP_NAME=Md. Faizur Rahman Khan Portfolio

PORT=4173
